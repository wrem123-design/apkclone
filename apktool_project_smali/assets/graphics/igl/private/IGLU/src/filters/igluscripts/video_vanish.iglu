[Filter IgluscriptVideoVanishFilter]
[BehaviorType fixedOutro]
[BehaviorDuration 750]
[AnimationCurve quadraticIn]

[Init]
fun init(Filter filter) {
  filter.passes = {{
      name = 'vanish, inputs = {'default},
      uniforms = {
        progress = 0.0,
        vanish_progress = 0.0,
        opacity = 1.0,
      },
      glslShader = glsl, metalShader = metal
    }};
}

[PreRender]
fun preRender(Filter filter) {
  f32 p = getParameterFloat('progress);

  # Vanish from left to right - progress 0.0 to 1.0 maps to vanish
  # The animation curve already applies easing
  f32 vanish_progress = p;
  f32 opacity = 1.0;

  setShaderUniform('vanish, 'progress, p);
  setShaderUniform('vanish, 'vanish_progress, vanish_progress);
  setShaderUniform('vanish, 'opacity, opacity);
}

string glsl = "varying vec2 sourceTextureCoordinate;

BaseUniformsOpenGL;

uniform float progress;
uniform float vanish_progress;
uniform float opacity;

void main() {
  vec2 uv = sourceTextureCoordinate;
  vec4 color = sampleInput(uv);

  // Horizontal vanish from left to right
  // vanish_progress: 0 = fully visible, 1 = fully vanished
  float mask = step(vanish_progress, uv.x);

  color.a = color.a * opacity * mask;
  gl_FragColor = toOutputFormat(color);
}
";

string metal = "
using namespace metal;
struct fragmentIn { float2 textureCoordinate [[user(locn0)]]; float2 sourceTextureCoordinate [[user(locn1)]]; };
struct fragmentOut { float4 _gl_FragColor [[color(0)]]; };
typedef struct {
  float4x4 content_transform;
  float4x4 texture_transform;
  float progress;
  float vanish_progress;
  float opacity;
 } Uniforms;

fragment fragmentOut fragmentShader(fragmentIn in [[stage_in]],
 constant Uniforms & uniforms [[buffer(1)]],
 DefaultInputs defaultInputs) {

  float2 uv = in.sourceTextureCoordinate;
  float4 color = sampleInput(defaultInputs, uv);

  // Horizontal vanish from left to right
  float mask = step(uniforms.vanish_progress, uv.x);

  color.a = color.a * uniforms.opacity * mask;
  return {toOutputFormat(color)};
}
";
